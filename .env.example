# ============================================================
# LAUNCHPAD BACKEND — Environment Configuration Template (.env.example)
# Runtime: Node.js / Express / Knex / PostgreSQL
# Copy this file to .env and configure values before starting the server.
# WARNING: NEVER commit the actual .env file to source control!
# ============================================================

# ── Application Runtime ──────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=Launchpad

# Canonical URLs (used for JWT audience/issuer, transactional email links, redirects)
# Local dev : APP_URL=http://localhost:3000, API_URL=http://localhost:5000
# Production: APP_URL=https://app.yourdomain.com, API_URL=https://api.yourdomain.com
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# ── PostgreSQL Database Connection ───────────────────────────
# Preferred for cloud providers (Neon, AWS RDS, Supabase, Render):
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/launchpad_db?sslmode=disable

# Fallback parameters (used if DATABASE_URL is empty)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=launchpad_db
DB_USER=launchpad_user
DB_PASSWORD=your_db_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Authentication & Cryptography ────────────────────────────
# Minimum 64 characters recommended for security.
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_64_characters_long_random_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_64_characters_long_random_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── CORS & Network Security ──────────────────────────────────
# Comma-separated list of allowed origins.
# In production, DO NOT use wildcard '*' when credentials: true is enabled!
# Example: https://app.yourdomain.com,https://admin.yourdomain.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4500

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── File Uploads & Local Storage ─────────────────────────────
UPLOAD_DEST=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/svg+xml,application/json

# ── Cloudinary Media CDN (Optional) ──────────────────────────
# Set CLOUDINARY_ENABLED=true to store uploaded assets on Cloudinary CDN.
# If false, assets are stored locally in UPLOAD_DEST.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=launchpad
CLOUDINARY_UPLOAD_PRESET=launchpad_preset

# ── Stripe Subscriptions & Billing ───────────────────────────
# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Transactional Email (SMTP) ───────────────────────────────
# Nodemailer SMTP settings. If user/pass are omitted, uses local StreamTransport (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Launchpad <no-reply@yourdomain.com>"
EMAIL_SUPPORT="support@yourdomain.com"

# ── Firebase Admin SDK (Cloud Messaging & Push) ──────────────
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_VAPID_KEY=your_vapid_key

# Firebase Admin Service Account (JSON file path or environment variables)
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Observability & Logs ─────────────────────────────────────
LOG_LEVEL=info
DEBUG_SQL=false
